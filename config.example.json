{
  "enabled": true,
  "policy": "cost",
  "policyWeights": null,
  "policyByClass": {},
  "pool": {
    "source": "favorites",
    "models": [],
    "include": [],
    "exclude": [],
    "maxModels": 8,
    "requireTools": true,
    "minContext": 32000,
    "localCostZero": true
  },
  "judge": {
    "enabled": true,
    "baseURL": "http://127.0.0.1:1234/v1",
    "model": "auto",
    "apiKey": "{env:OMLX_API_KEY}",
    "timeoutMs": 5000,
    "cacheTtlMs": 600000,
    "cacheSize": 128,
    "provision": {
      "enabled": true,
      "backend": "auto",
      "repo": "mlx-community/Qwen3-4B-Instruct-2507-4bit",
      "adminApiKey": "{env:OMLX_ADMIN_API_KEY}",
      "readSettingsKey": true,
      "hfToken": "{env:HF_TOKEN}",
      "allowNonMlx": false
    }
  },
  "pin": {
    "mode": "balanced",
    "switchThreshold": 0.12,
    "idleTtlMs": 300000,
    "maxAgeMs": 1800000,
    "maxTurns": 8,
    "costSwitchRatio": 4,
    "flipFlopTurns": 3,
    "cacheHitRatio": 0.8
  },
  "optimiser": {
    "enabled": true,
    "reserveOutputTokens": 8192,
    "safetyTokens": 1024,
    "maxToolTokens": 2000,
    "keepRecentToolOutputs": 3,
    "keepRecentTurns": 2
  },
  "limits": {
    "shortfallTolerance": 0.2,
    "allowLocalForComplexity": 2,
    "expectedOutputTokens": 1200,
    "contextFitRatio": 0.9
  },
  "quality": {
    "overrides": {},
    "source": "lmarena",
    "category": "webdev",
    "refreshHours": 24,
    "timeoutMs": 10000,
    "lmarena": {
      "dataset": "lmarena-ai/leaderboard-dataset",
      "config": "webdev",
      "split": "latest"
    }
  },
  "latency": {
    "overrides": {},
    "localProviders": []
  },
  "subagents": {
    "enabled": true,
    "overrideExplicitModel": false,
    "default": {
      "policy": "cost",
      "qualityFloor": 0.0
    },
    "agents": {
      "explore": {
        "policy": "latency",
        "qualityFloor": 0.45,
        "minContext": 128000
      },
      "general": {
        "policy": "cost",
        "qualityFloor": 0.55
      },
      "review": {
        "policy": "quality",
        "qualityFloor": 0.75
      },
      "plan": {
        "policy": "quality",
        "qualityFloor": 0.8
      }
    }
  },
  "telemetry": {
    "enabled": true
  },
  "failover": {
    "enabled": true,
    "cooldownMs": 300000,
    "serverCooldownMs": 60000,
    "authCooldownMs": 1800000,
    "redirectTtlMs": 60000,
    "retryDelayMs": 1000
  },
  "debug": false
}
